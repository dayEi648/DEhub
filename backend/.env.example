# RAG 向量检索相似度阈值（0~1，低于此值的结果不会注入 AI 上下文）
RAG_MIN_SIMILARITY=0.6

# ---------- Agent 质量评估配置 ----------
# 是否启用对话后自动质量评估
AI_CHAT_EVAL_ENABLED=True
# 评估抽样率（0.0~1.0），1.0=评估全部 trace，0.5=只评估 50%
AI_CHAT_EVAL_SAMPLE_RATE=1.0

# Docker 部署配置（容器间通过服务名通信，使用默认端口）
