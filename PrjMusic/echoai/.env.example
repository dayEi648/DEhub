# 数据库
ECHOMUSIC_DB_URL=postgresql://postgres:131420@localhost:5432/echomusic
ECHOVECTOR_DB_URL=postgresql://postgres:131420@localhost:5432/echovector

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT（与 Spring 一致）
JWT_SECRET=change-me-to-a-random-string

# LLM（阿里云百炼）
OPENAI_API_KEY=sk-xxx
OPENAI_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_MODEL=deepseek-v4-pro
OPENAI_MODEL_FAST=deepseek-v4-flash

# Embedding
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSION=1024

# IQS 搜索
IQS_API_KEY=xxx
IQS_ENDPOINT=https://cloud-iqs.aliyuncs.com/search/unified

# Spring 后端地址（AI 服务写操作时调用）
SPRING_BASE_URL=http://localhost:8080
